{
  "name": "ashes-of-principalities",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/server.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "node server/server.mjs --serve-dist",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
